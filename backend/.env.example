APP_NAME="mobiST Tech"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:18080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=single
LOG_LEVEL=warning

# A separate target instance only. Never use a source database or connection URL.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=13306
DB_DATABASE=mobisttech_local
DB_USERNAME=mobisttech
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_COOKIE=mobisttech_foundation_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
CACHE_STORE=file
DERIVED_CACHE_STORE=file
PRIVATE_OBJECT_DISK=local
CACHE_PREFIX=mobisttech_local_

# Reserved for derived cache/throttling; disabled until an isolated Redis service is available.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=mobisttech_local_

FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.invalid
MAIL_FROM_NAME="mobiST Tech"
BROADCAST_CONNECTION=log
EXTERNAL_INTEGRATIONS_ENABLED=false

# S3-compatible adapter is installed but not activated in local foundations.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="mobiST Tech"
