APP_NAME="mobiST Tech"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:18080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=single
LOG_LEVEL=warning

# A separate target instance only. Never use a source database or connection URL.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=13306
DB_DATABASE=mobisttech_local
DB_USERNAME=mobisttech
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_COOKIE=mobisttech_foundation_session
SESSION_LIFETIME=120
# Realm-specific policy is authoritative: Admin 30 minutes; Customer 120 minutes.
# Customer Remember Me is capped at 30 days; Admin Remember Me is disabled.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Production requires distinct HTTPS customer/admin hosts; no wildcard cookie domain.
IDENTITY_CUSTOMER_ORIGIN=http://127.0.0.1:13000
IDENTITY_ADMIN_ORIGIN=http://127.0.0.1:18080
# Keep disabled until approved delivery and the later reset UI are configured.
IDENTITY_RECOVERY_DELIVERY_ENABLED=false
# Offline owner code recovery requires a separate, explicitly account-bound activation. Never commit a real owner UUID.
IDENTITY_OFFLINE_OWNER_RECOVERY_ENABLED=false
IDENTITY_OFFLINE_OWNER_ADMIN_PUBLIC_ID=
ENGAGEMENT_EXTERNAL_DELIVERY_ENABLED=false
ENGAGEMENT_UNSUBSCRIBE_SECRET=
QUEUE_CONNECTION=database
CACHE_STORE=file
DERIVED_CACHE_STORE=file
PRIVATE_OBJECT_DISK=local
CACHE_PREFIX=mobisttech_local_

# Reserved for derived cache/throttling; disabled until an isolated Redis service is available.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=mobisttech_local_

FILESYSTEM_DISK=local
MAIL_MAILER=array
MAIL_FROM_ADDRESS=mobisttech@gmail.com
MAIL_FROM_NAME="mobiST Technologies"
BROADCAST_CONNECTION=log
EXTERNAL_INTEGRATIONS_ENABLED=false
BACKUP_EXTERNAL_JOBS_ENABLED=false
BACKUP_KEY_ID=
COMMERCE_RESERVATION_MINUTES=20

# External payment providers remain disabled until authentic H-02 contracts and credentials pass acceptance.
# Provider secrets are environment-owned and must never be entered in checkout or committed.

# Application-level Google OAuth secrets are provisioned per environment and never entered in Admin UI.
# Gmail uses only gmail.send. Drive uses drive.file and a private server-side rclone configuration.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://127.0.0.1:18080/internal/admin/integrations/gmail/callback
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://127.0.0.1:18080/internal/admin/integrations/google_drive/callback
RCLONE_BINARY=rclone
RCLONE_CONFIG_PATH=

# S3-compatible adapter is installed but not activated in local foundations.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="mobiST Tech"
