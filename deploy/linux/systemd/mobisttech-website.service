[Unit]
Description=mobiST Tech customer Website (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mobisttech
Group=mobisttech
WorkingDirectory=/srv/mobisttech/current/website
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
EnvironmentFile=/etc/mobisttech/website.env
ExecStart=/usr/bin/node ./node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 13000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
