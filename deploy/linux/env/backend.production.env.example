# TEMPLATE ONLY. Install as /etc/mobisttech/backend.env (0600); never commit actual values.
# Separate environment instances have separate DB/schema, keys, domains and private stores.
APP_NAME="mobiST Tech"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://__ADMIN_FQDN__
APP_KEY=__SET_OUTSIDE_GIT__
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mobisttech_production
DB_USERNAME=__PRODUCTION_DB_USER__
DB_PASSWORD=__SET_OUTSIDE_GIT__
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SESSION_COOKIE=mobisttech_production_session
IDENTITY_CUSTOMER_ORIGIN=https://__CUSTOMER_FQDN__
IDENTITY_ADMIN_ORIGIN=https://__ADMIN_FQDN__
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90
CACHE_STORE=redis
CACHE_PREFIX=mobisttech_production_
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=__SET_OUTSIDE_GIT__
REDIS_PREFIX=mobisttech_production_
REDIS_CACHE_DB=1
SESSION_CONNECTION=mysql
LOG_CHANNEL=stderr
LOG_LEVEL=warning
FILESYSTEM_DISK=local
PRIVATE_OBJECT_DISK=local
# S3 is optional for application-private objects, and is separate from encrypted backup S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ROOT=mobisttech/private
MAIL_MAILER=log
EXTERNAL_INTEGRATIONS_ENABLED=false
IDENTITY_RECOVERY_DELIVERY_ENABLED=false
ENGAGEMENT_EXTERNAL_DELIVERY_ENABLED=false
BACKUP_EXTERNAL_JOBS_ENABLED=false
BACKUP_KEY_ID=__SET_OUTSIDE_GIT_IF_APP_BACKUP_ENABLED__
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
