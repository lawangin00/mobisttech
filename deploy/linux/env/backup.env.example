# TEMPLATE ONLY: /etc/mobisttech/backup.env (0600), never installed/enabled automatically.
# Enable only after an authorized, short-lived application-write quiescence barrier exists.
MOBIST_BACKUP_ENABLED=no
MOBIST_DEPLOYMENT_ENV=production
MOBIST_WRITES_QUIESCED=no
MYSQL_DATABASE=mobisttech_production
MYSQL_CLIENT_CNF=/etc/mobisttech/backup-mysql.cnf
BACKUP_TMP_ROOT=/run/mobisttech-backup
PRIVATE_OBJECT_MODE=local
PRIVATE_OBJECT_DIR=/srv/mobisttech/shared/private
APP_PRIVATE_S3_URI=
APP_S3_SOURCE_PROFILE=app-readonly
RESTIC_REPOSITORY=s3:https://__INDEPENDENT_BACKUP_S3_ENDPOINT__/__ENCRYPTED_BACKUP_BUCKET__/mobisttech/production
RESTIC_PASSWORD_FILE=/etc/mobisttech/restic-password
AWS_SHARED_CREDENTIALS_FILE=/etc/mobisttech/aws-backup-credentials
AWS_PROFILE=backup
