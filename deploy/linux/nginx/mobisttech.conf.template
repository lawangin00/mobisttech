# Render only after separate authorization of hosts/certificates; never enable this template as-is.
# One public Customer host (Next.js), one distinct Admin host (Laravel), and loopback-only API.
server {
    listen 80;
    server_name __CUSTOMER_FQDN__ __ADMIN_FQDN__;
    return 308 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name __CUSTOMER_FQDN__;
    ssl_certificate __CUSTOMER_CERT__;
    ssl_certificate_key __CUSTOMER_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header X-Content-Type-Options nosniff always;
    client_max_body_size 24m;
    location / {
        proxy_pass http://127.0.0.1:13000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 90s;
    }
}
server {
    listen 443 ssl;
    server_name __ADMIN_FQDN__;
    root /srv/mobisttech/current/backend/public;
    index index.php;
    ssl_certificate __ADMIN_CERT__;
    ssl_certificate_key __ADMIN_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header X-Content-Type-Options nosniff always;
    client_max_body_size 24m;
    include /etc/nginx/snippets/mobisttech-laravel.conf;
}
# Only the local Next.js server may call the Laravel backend over cleartext loopback.
server {
    listen 127.0.0.1:18080;
    server_name 127.0.0.1;
    root /srv/mobisttech/current/backend/public;
    index index.php;
    client_max_body_size 24m;
    include /etc/nginx/snippets/mobisttech-laravel.conf;
}
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
